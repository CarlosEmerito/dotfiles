/**
 * EmeDotEme Custom Theme - Purple & Yellow
 * Menú de aplicaciones: 3 columnas, búsqueda fuzzy y modos internos.
 */

configuration {
    modes: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus";

    /* Solo el nombre de la app, sin el nombre genérico entre paréntesis. */
    drun-display-format: "{name}";
    drun-match-fields: "name";

    /* Rofi 2.1.1 muestra cada acción del .desktop como una entrada más
       (Steam - Tienda, LibreOffice - Calc...). Se desactiva para no llenar
       el menú de duplicados. */
    drun-show-actions: false;

    /* Búsqueda tolerante a errores y orden por relevancia. */
    matching: "fuzzy";
    case-smart: true;
    tokenize: true;
    sorting-method: "fzf";
    sort: true;
    cycle: true;
    hover-select: false;
    fixed-num-lines: false;
    scroll-method: 1;
}

* {
    bg-col:  #191324;
    bg-col-light: #2A1E38;
    border-col: #9D4EDD;
    selected-col: #F9D342;
    purple: #9D4EDD;
    yellow: #F9D342;
    fg-col: #EBE5F0;
    fg-col2: #F9D342;
    grey: #A394B0;

    font: "JetBrainsMono Nerd Font 14";
}

element-text, element-icon , mode-switcher {
    background-color: inherit;
    text-color:       inherit;
}

window {
    width: 900px;
    border: 2px;
    border-color: @purple;
    background-color: @bg-col;
    border-radius: 16px;
}

mainbox {
    background-color: @bg-col;
}

inputbar {
    children: [prompt,entry];
    background-color: @bg-col;
    border-radius: 5px;
    padding: 2px;
}

prompt {
    enabled: false;
    background-color: @yellow;
    padding: 6px;
    text-color: @bg-col;
    border-radius: 3px;
    margin: 20px 0px 0px 20px;
}

entry {
    padding: 8px;
    margin: 20px 0px 0px 20px;
    text-color: @fg-col;
    placeholder: "Buscar aplicaciones…";
    placeholder-color: @grey;
    background-color: @bg-col;
}

listview {
    border: 0px 0px 0px;
    padding: 6px 0px 0px;
    margin: 12px 0px 0px 20px;
    columns: 3;
    lines: 6;
    background-color: @bg-col;
}

element {
    padding: 6px;
    background-color: @bg-col;
    text-color: @fg-col;
}

element-icon {
    size: 32px;
}

element selected.normal {
    background-color: @selected-col;
    text-color: @bg-col;
    border-radius: 4px;
}

mode-switcher {
    spacing: 0;
}

button {
    padding: 10px;
    background-color: @bg-col-light;
    text-color: @grey;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

button selected {
    background-color: @bg-col;
    text-color: @yellow;
}

message {
    background-color: @bg-col-light;
    margin: 2px;
    padding: 2px;
    border-radius: 5px;
}

textbox {
    padding: 6px;
    margin: 20px 0px 0px 20px;
    text-color: @yellow;
    background-color: @bg-col-light;
}
