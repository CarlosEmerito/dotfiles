[Unit]
Description=EmeBotEme Voice AI Assistant
After=network.target sound.target

[Service]
Type=simple
# El token de Hugging Face es opcional: sin él la IA funciona en modo local/básico.
EnvironmentFile=-%h/.config/emeboteme/.env
Environment="PATH=%h/.opencode/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/bin/python -u %h/.config/emeboteme/ai/main.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
