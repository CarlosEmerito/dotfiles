#!/bin/sh
# Precalienta systeminfo antes de arrancar Waybar.
# Waybar detecta el protocolo Lua en el primer dispatch consultando systeminfo;
# en frío esa consulta tarda ~800 ms y bloquea la barra. Hacerla aquí y
# refrescarla cada 2 minutos evita el tirón del primer clic.
if command -v hyprctl >/dev/null 2>&1; then
    hyprctl systeminfo >/dev/null 2>&1
fi

/usr/bin/waybar "$@" &
wpid=$!
loop_pid=

if command -v hyprctl >/dev/null 2>&1; then
    (
        while kill -0 "$wpid" 2>/dev/null; do
            hyprctl systeminfo >/dev/null 2>&1
            sleep 120
        done
    ) >/dev/null 2>&1 &
    loop_pid=$!
fi

wait "$wpid"

if [ -n "$loop_pid" ]; then
    kill "$loop_pid" 2>/dev/null
    wait "$loop_pid" 2>/dev/null
fi
